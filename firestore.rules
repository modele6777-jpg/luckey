rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isKnowledgeAdmin() {
      return isSignedIn() && request.auth.token.knowledgeAdmin == true;
    }

    // 1. Shared State Profile & Standalone User Profiles
    match /sharedState/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 1b. Unified Lucy chat thread (cross-device sync)
    match /chatThreads/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Soul Mirror persistent state
    match /soul_mirror/{userId}/dapps/{dappId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Partitioned History entries for each applet explicitly
    match /bluebird_history/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /orange_history/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /muse_history/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /trinity_history/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /heal_history/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /aura_healing_missions/{userId}/missions/{missionId} {
      allow read, write: if isOwner(userId);
    }

    // 3b. Re:Bible Verses & Sacred Annotations
    match /rebible_verses/{userId}/verses/{verseId} {
      allow read, write: if isOwner(userId);
    }

    // 3c. Trinity Daily Lucky (quests, reports, boosts)
    match /trinity_daily_lucky/{userId}/days/{dayId} {
      allow read, write: if isOwner(userId);
    }

    // 4. Cross-Device Paired Real-Time Vaults (PIN / Device Pair Sync)
    match /pairedVaults/{vaultId} {
      allow read, write: if true;
    }

    // 4b. Community Shared Achievement Cards
    match /epilogue_community/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // 5. Legacy Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    // Lucy knowledge growth is isolated from counseling memory and pairedVaults.
    match /lucyKnowledgeSettings/{settingId} {
      allow read, create, update: if isKnowledgeAdmin();
      allow delete: if false;
    }
    match /lucyKnowledgeSourceCandidates/{candidateId} {
      allow read: if isKnowledgeAdmin();
      allow write: if false;
    }
    match /lucyKnowledgeDrafts/{draftId} {
      allow read, create, update: if isKnowledgeAdmin();
      allow delete: if false;
    }
    match /lucyKnowledgeVersions/{versionId} {
      allow read: if isKnowledgeAdmin();
      allow create: if isKnowledgeAdmin() && request.resource.data.status == 'approved';
      allow update, delete: if false;
    }
    match /lucyKnowledgePublished/{cardId} {
      allow read: if isSignedIn();
      allow create, update: if isKnowledgeAdmin() && request.resource.data.status == 'approved';
      allow delete: if false;
    }
    match /lucyKnowledgeResearchRuns/{runId} {
      allow read: if isKnowledgeAdmin();
      allow create: if isKnowledgeAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'reserved'
        && request.resource.data.reservedUsd is number
        && request.resource.data.reservedUsd > 0;
      allow update: if isKnowledgeAdmin()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'reserved'
        && request.resource.data.status in ['completed', 'failed_reserved']
        && request.resource.data.reservedUsd == resource.data.reservedUsd
        && request.resource.data.actualUsd is number
        && request.resource.data.actualUsd >= 0;
      allow delete: if false;
    }
    match /lucyKnowledgeBudgetDays/{dayId} {
      allow read: if isKnowledgeAdmin();
      allow create, update: if isKnowledgeAdmin()
        && request.resource.data.reservedUsd is number
        && request.resource.data.reservedUsd >= 0;
      allow delete: if false;
    }

    // 0. Fallback Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
