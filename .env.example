# 공개 주소 및 실행 설정. LUCKEY_APP_ORIGINS에는 끝 슬래시 없는 HTTPS 주소를 쉼표로 구분합니다.
NODE_ENV=production
PORT=3000
LUCKEY_APP_ORIGINS=

# 서버 전용 AI 환경변수. 실제 값은 호스트의 비밀 설정에 입력합니다.
# Gemini 별칭: gemini, GOOGLE_GENAI_API_KEY, GOOGLE_API_KEY, AI_API_KEY, API_KEY.
AI_TYPE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_IMAGE_MODEL=
XAI_API_KEY=
OPENAI_API_KEY=

# 선택 음성·검색 제공자.
TTS_PROVIDER=
GEMINI_TTS_MODEL=
CLOUD_GEMINI_TTS=
CLOUD_GEMINI_TTS_MODEL=
GOOGLE_CLOUD_TTS_API_KEY=
GOOGLE_CLOUD_TTS_CREDENTIALS=
VERTEX_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
ORB_LIVE_USAGE_PRICES_USD=

# 연구 작업 전용 비밀 변수는 스케줄러에만 넣습니다.
# 작업을 검증한 뒤 웹 서비스에서 SCHEDULE_CONFIGURED를 true로 바꿉니다.
LUCY_KNOWLEDGE_SCHEDULER_CREDENTIALS=
LUCY_KNOWLEDGE_SCHEDULE_CONFIGURED=false
LUCY_KNOWLEDGE_MODEL=
LUCY_KNOWLEDGE_HARD_MAX_DAILY_USD=
LUCY_KNOWLEDGE_HARD_MAX_RUN_USD=
LUCY_KNOWLEDGE_INPUT_USD_PER_MILLION=
LUCY_KNOWLEDGE_OUTPUT_USD_PER_MILLION=
LUCY_KNOWLEDGE_MAX_INPUT_TOKENS=
LUCY_KNOWLEDGE_MAX_OUTPUT_TOKENS=

# 선택 어댑터 설정. Sites Worker의 DB/ASSETS는 환경변수가 아닌 바인딩입니다.
LUCKEY_API_ORIGIN=
# Sites 음성 토큰 전용 HTTPS 서버. 다른 API에는 적용하지 않습니다.
LUCKEY_LIVE_API_ORIGIN=
LUCKEY_MCP_TOKEN=

# 빌드 공개 설정에는 비밀을 넣지 않습니다.
VITE_GEMINI_MODEL=
